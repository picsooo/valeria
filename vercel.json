{
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow, noarchive"
    },
    {
     "key": "Content-Security-Policy",
     "value": "frame-ancestors 'none'"
    },
    {
     "key": "X-Frame-Options",
     "value": "DENY"
    },
    {
     "key": "Referrer-Policy",
     "value": "no-referrer"
    }
   ]
  }
 ]
}