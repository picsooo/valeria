Options -Indexes
DirectoryIndex index.html
RewriteEngine On

# HTTPS + domaine sans www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://maisonvaleria.net/$1 [R=301,L]

# Anciennes adresses
RewriteRule ^signature/?$ / [R=301,L]
RewriteRule ^signature-rdv/?$ /rendez-vous [R=301,L]
RewriteRule ^index(\.html)?$ / [R=301,L]

# /page.html -> /page
RewriteCond %{THE_REQUEST} \s/([^.\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# /page -> page.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(woff2?|ttf|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpe?g|png|webp|svg|mp4|webm)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
